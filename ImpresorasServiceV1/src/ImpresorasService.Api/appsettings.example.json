{
  "_comment": "Copiar a appsettings.Development.json o usar variables de entorno / user-secrets. No commitear secretos.",
  "ConnectionStrings": {
    "PrintQueue": "Host=HOST;Port=5432;Database=BD;Username=USUARIO;Search Path=impresoras"
  },
  "Ingestion": {
    "PollIntervalSeconds": 5,
    "BatchSize": 100
  },
  "Source": {
    "SourceSystem": "ERP",
    "LeaseSeconds": 90
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "GENERAR-CLAVE-ALEATORIA-MINIMO-32-CARACTERES",
    "Issuer": "ImpresorasService",
    "Audience": "ImpresorasService"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.empresa.com"
    ]
  },
  "Bootstrap": {
    "SeedDefaultUsers": false,
    "EnableFirstAdminEndpoint": false
  },
  "Globalization": {
    "Culture": "es-ES"
  }
}

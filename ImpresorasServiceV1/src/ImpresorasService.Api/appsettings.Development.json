{
  "Database": {
    "ApplyMigrations": false
  },
  "ConnectionStrings": {
    "PrintQueue": ""
  },
  "Source": {
    "Mode": "SapHana"
  },
  "SapHana": {
    "SourceSystem": "ERP",
    "LeaseSeconds": 90
  },
  "Bootstrap": {
    "SeedDefaultUsers": false,
    "EnableFirstAdminEndpoint": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Telegram": {
    "Enabled": true,
    "BotToken": ""
  }
}

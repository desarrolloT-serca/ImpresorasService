@inherits LayoutComponentBase
@using ImpresorasService.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<MudThemeProvider @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ms-3">Impresoras Service</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                @if (context.User.IsInRole("Supervisor"))
                {
                    <MudSelect T="int?" Label="Tienda" Variant="Variant.Outlined" 
                              Value="@_selectedStoreId" ValueChanged="@(v => _selectedStoreId = v)"
                              AnchorOrigin="Origin.BottomCenter" Class="me-3" Style="max-width: 140px;">
                        <MudSelectItem T="int?" Value="null">Todas</MudSelectItem>
                        @foreach (var s in _storeIds)
                        {
                            <MudSelectItem T="int?" Value="@s">Tienda @s</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudText Typo="Typo.body2" Class="me-2">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="HandleLogout" title="Cerrar sesión" />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Text" Color="Color.Inherit">Iniciar sesión</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Menú</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private int? _selectedStoreId;
    private readonly List<int> _storeIds = [1, 2, 3];

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

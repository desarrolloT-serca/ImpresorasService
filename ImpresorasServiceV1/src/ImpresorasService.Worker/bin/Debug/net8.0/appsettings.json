{
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "PrintQueue": "Data Source=../../impresoras-local.db" },
  "Ingestion": { "PollIntervalSeconds": 5, "BatchSize": 100 },
  "PrintExecution": {
    "PollIntervalSeconds": 5,
    "BatchSize": 10,
    "TimeoutSeconds": 30,
    "MaxAttempts": 4,
    "BackoffSeconds": [15, 30, 60, 90],
    "UseRealSpooler": true
  },
  "Source": { "Mode": "SqlTest" },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}

{
  "_comment": "Copiar a appsettings.Development.json o usar variables de entorno. No commitear secretos.",
  "Database": {
    "Provider": "Hana",
    "ApplyMigrations": false
  },
  "ConnectionStrings": {
    "PrintQueue": "ServerNode=HOST:PORT;UID=USER;PWD=SECRET;Current Schema=SCHEMA"
  },
  "PrinterConnectivity": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "TimeoutMsPerPort": 1500,
    "Ports": [515, 9100, 631, 445, 139],
    "MaxParallelChecks": 1
  },
  "Ingestion": {
    "PollIntervalSeconds": 2,
    "BatchSize": 20
  },
  "PrintExecution": {
    "PollIntervalSeconds": 5,
    "BatchSize": 10,
    "TimeoutSeconds": 30,
    "MaxAttempts": 4,
    "BackoffSeconds": [15, 30, 60, 90],
    "PrintSettings": "fit",
    "UseRealSpooler": true,
    "KeepTempFileOnFailure": false,
    "SpoolAcceptedMaxAgeSeconds": 120,
    "SpoolAcceptedWatchIntervalSeconds": 10,
    "SpoolAcceptedWatchBatchSize": 50
  },
  "Source": {
    "Mode": "SapHana"
  },
  "SapHana": {
    "ConnectionString": "DRIVER={HDBODBC};SERVERNODE=HOST:PORT;UID=USER;PWD=SECRET",
    "Schema": "YOUR_SCHEMA",
    "Table": "printer_source_print_job",
    "SourceSystem": "SAP-HANA",
    "LeaseSeconds": 90
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}

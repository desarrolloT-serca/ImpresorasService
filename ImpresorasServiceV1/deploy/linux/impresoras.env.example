# /etc/impresoras/impresoras.env: root:impresoras, permisos 0640. La leen la API y el Worker.
# scripts/install-linux.sh la crea desde aquí y genera las dos claves.
ConnectionStrings__PrintQueue="Host=RELLENAR;Port=5433;Database=serca;Username=RELLENAR;Password=RELLENAR;Search Path=admon"
Jwt__Secret=GENERAR
# El ERP lo necesita en IMPRESION_SECRETO (mismo valor).
Erp__Secret=GENERAR
# Solo la API escucha. En el mismo servidor que el ERP, solo en local.
ASPNETCORE_URLS=http://127.0.0.1:5105
# Solo por IP (IPP): en Linux no hay colas de Windows.
PrintExecution__SoloIp=true
PrintExecution__UseRealSpooler=false
# El token del bot y los chats están en la base.
Telegram__Enabled=true
Dashboard__ThresholdRulesFilePath=/var/lib/impresoras/dashboard-threshold-rules.json
